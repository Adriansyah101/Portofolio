# Copy this file to `.env` (never commit `.env`) and fill in your values.

# --- EmailJS (https://dashboard.emailjs.com) -------------------------------
# Template variables used by the contact form: {{name}}, {{email}}, {{message}}
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# --- Optional link configuration ------------------------------------------
# GitHub username used to build repository links. When empty, the site
# derives it from a *.github.io hostname, and the GitHub Actions workflow
# fills it automatically with the repository owner.
VITE_GITHUB_USERNAME=
# Exact repository name of the Gangstar: Miami Vindication PC port
# (enables direct repo + releases links instead of a filtered repo list).
VITE_GANGSTAR_REPO=
# X / Twitter handle without the "@".
VITE_TWITTER_HANDLE=
